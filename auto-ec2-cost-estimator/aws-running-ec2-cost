def get_cloudwatch_log_groups(logs_client, instance_id: str) -> list[str]:
    matched = []
    try:
        paginator = logs_client.get_paginator("describe_log_groups")
        for page in paginator.paginate():
            for lg in page["logGroups"]:
                if instance_id in lg.get("logGroupName", ""):
                    matched.append(lg["logGroupName"])
    except ClientError:
        pass
    return matched


