def get_instance_details(ec2_client, instance_id: str) -> dict:
    """Fetch core metadata for the EC2 instance."""
    try:
        resp = ec2_client.describe_instances(InstanceIds=[instance_id])
        reservations = resp.get("Reservations", [])
        if not reservations:
            sys.exit(f"ERROR: Instance {instance_id} not found in this region/account.")
        inst = reservations[0]["Instances"][0]
        return inst
    except ClientError as e:
        sys.exit(f"ERROR fetching instance details: {e}")


def tag_value(tags: list, key: str) -> str:
    for t in (tags or []):
        if t["Key"] == key:
            return t["Value"]
    return ""


def get_ebs_volumes(ec2_client, instance_id: str) -> list[dict]:
    resp = ec2_client.describe_volumes(
        Filters=[{"Name": "attachment.instance-id", "Values": [instance_id]}]
    )
    return resp.get("Volumes", [])


def get_ebs_snapshots(ec2_client, volume_ids: list[str], account_id: str) -> list[dict]:
    if not volume_ids:
        return []
    snapshots = []
    for vid in volume_ids:
        resp = ec2_client.describe_snapshots(
            Filters=[{"Name": "volume-id", "Values": [vid]}],
            OwnerIds=[account_id],
        )
        snapshots.extend(resp.get("Snapshots", []))
    return snapshots


def get_elastic_ips(ec2_client, instance_id: str) -> list[dict]:
    resp = ec2_client.describe_addresses(
        Filters=[{"Name": "instance-id", "Values": [instance_id]}]
    )
    return resp.get("Addresses", [])


def get_load_balancers(session, sg_ids: list[str]) -> list[dict]:
    """Find ELBv2 load balancers that share at least one Security Group with the instance."""
    elb_client = session.client("elbv2")
    sg_set = set(sg_ids)
    matched = []
    try:
        paginator = elb_client.get_paginator("describe_load_balancers")
        for page in paginator.paginate():
            for lb in page["LoadBalancers"]:
                lb_sgs = set(lb.get("SecurityGroups", []))
                if lb_sgs & sg_set:
                    matched.append(lb)
    except ClientError:
        pass
    return matched


def get_nat_gateways(ec2_client, sg_ids: list[str]) -> list[dict]:
    """NAT Gateways don't have SGs; find ones in subnets used by ENIs sharing the instance's SGs."""
    matched = []
    try:
        # Find ENIs that share any of the instance's security groups
        resp = ec2_client.describe_network_interfaces(
            Filters=[{"Name": "group-id", "Values": sg_ids}]
        )
        subnet_ids = {eni["SubnetId"] for eni in resp.get("NetworkInterfaces", []) if "SubnetId" in eni}
        if subnet_ids:
            ngw_resp = ec2_client.describe_nat_gateways(
                Filters=[{"Name": "subnet-id", "Values": list(subnet_ids)}]
            )
            matched = ngw_resp.get("NatGateways", [])
    except ClientError:
        pass
    return matched


def get_rds_instances(session, sg_ids: list[str]) -> list[dict]:
    """Find RDS instances sharing at least one Security Group with the EC2 instance."""
    rds    = session.client("rds")
    sg_set = set(sg_ids)
    matched = []
    try:
        paginator = rds.get_paginator("describe_db_instances")
        for page in paginator.paginate():
            for db in page["DBInstances"]:
                db_sgs = {sg["VpcSecurityGroupId"] for sg in db.get("VpcSecurityGroups", [])}
                if db_sgs & sg_set:
                    matched.append(db)
    except ClientError:
        pass
    return matched


