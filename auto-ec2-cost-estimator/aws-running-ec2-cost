def create_session(profile: str | None, region: str | None):
    kwargs = {}
    if profile:
        kwargs["profile_name"] = profile
    if region:
        kwargs["region_name"] = region
    try:
        session = boto3.Session(**kwargs)
        # Quick credential check
        sts = session.client("sts")
        identity = sts.get_caller_identity()
        print(f"[AUTH] Connected as: {identity['Arn']}")
        return session
    except NoCredentialsError:
        sys.exit(
            "ERROR: No AWS credentials found.\n"
            "Run 'aws configure' or set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env vars."
        )
    except ClientError as e:
        sys.exit(f"ERROR: AWS authentication failed: {e}")


