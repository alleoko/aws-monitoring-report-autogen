def get_s3_buckets(session, bucket_names: list[str]) -> list[dict]:
    if not bucket_names:
        return []
    s3 = session.client("s3")
    result = []
    for name in bucket_names:
        try:
            loc = s3.get_bucket_location(Bucket=name)
            size_resp = s3.list_objects_v2(Bucket=name)
            total_bytes = sum(o["Size"] for o in size_resp.get("Contents", []))
            result.append({"Name": name, "Region": loc.get("LocationConstraint") or "us-east-1", "SizeGB": round(total_bytes / 1_073_741_824, 4)})
        except ClientError as e:
            print(f"[WARN] S3 bucket '{name}' not accessible: {e}")
    return result


def get_elasticache_clusters(session, sg_ids: list[str]) -> list[dict]:
    """Find ElastiCache clusters sharing at least one Security Group with the EC2 instance."""
    ec_client = session.client("elasticache")
    sg_set    = set(sg_ids)
    matched   = []
    try:
        paginator = ec_client.get_paginator("describe_cache_clusters")
        for page in paginator.paginate(ShowCacheNodeInfo=True):
            for cluster in page["CacheClusters"]:
                cluster_sgs = {sg["SecurityGroupId"] for sg in cluster.get("SecurityGroups", [])}
                if cluster_sgs & sg_set:
                    cluster["_matched_sgs"] = list(cluster_sgs & sg_set)
                    matched.append(cluster)
    except ClientError:
        pass
    return matched


def get_secrets(session, secret_ids: list[str]) -> list[dict]:
    if not secret_ids:
        return []
    sm = session.client("secretsmanager")
    result = []
    for sid in secret_ids:
        try:
            resp = sm.describe_secret(SecretId=sid)
            result.append(resp)
        except ClientError as e:
            print(f"[WARN] Secret '{sid}' not accessible: {e}")
    return result


def get_kms_keys(session, key_ids: list[str]) -> list[dict]:
    if not key_ids:
        return []
    kms = session.client("kms")
    result = []
    for kid in key_ids:
        try:
            resp = kms.describe_key(KeyId=kid)
            result.append(resp.get("KeyMetadata", {}))
        except ClientError as e:
            print(f"[WARN] KMS key '{kid}' not accessible: {e}")
    return result


def get_vpc_endpoints(session, endpoint_ids: list[str]) -> list[dict]:
    if not endpoint_ids:
        return []
    ec2 = session.client("ec2")
    try:
        resp = ec2.describe_vpc_endpoints(VpcEndpointIds=endpoint_ids)
        return resp.get("VpcEndpoints", [])
    except ClientError as e:
        print(f"[WARN] VPC endpoints not accessible: {e}")
        return []


def get_sqs_queues(session, queue_names: list[str]) -> list[dict]:
    if not queue_names:
        return []
    sqs = session.client("sqs")
    result = []
    for qname in queue_names:
        try:
            url_resp = sqs.get_queue_url(QueueName=qname)
            url = url_resp["QueueUrl"]
            attrs = sqs.get_queue_attributes(QueueUrl=url, AttributeNames=["All"])
            result.append({"Name": qname, "Url": url, "Attributes": attrs.get("Attributes", {})})
        except ClientError as e:
            print(f"[WARN] SQS queue '{qname}' not accessible: {e}")
    return result


def get_sns_topics(session, topic_arns: list[str]) -> list[dict]:
    if not topic_arns:
        return []
    sns = session.client("sns")
    result = []
    for arn in topic_arns:
        try:
            attrs = sns.get_topic_attributes(TopicArn=arn)
            result.append({"Arn": arn, "Attributes": attrs.get("Attributes", {})})
        except ClientError as e:
            print(f"[WARN] SNS topic '{arn}' not accessible: {e}")
    return result


def get_ecr_repos(session, repo_names: list[str]) -> list[dict]:
    if not repo_names:
        return []
    ecr = session.client("ecr")
    result = []
    for rname in repo_names:
        try:
            resp = ecr.describe_repositories(repositoryNames=[rname])
            repos = resp.get("repositories", [])
            for repo in repos:
                # Get image sizes
                images = ecr.describe_images(repositoryName=rname).get("imageDetails", [])
                total_bytes = sum(i.get("imageSizeInBytes", 0) for i in images)
                repo["TotalSizeGB"] = round(total_bytes / 1_073_741_824, 4)
                result.append(repo)
        except ClientError as e:
            print(f"[WARN] ECR repo '{rname}' not accessible: {e}")
    return result


def get_backup_plans(session, plan_ids: list[str]) -> list[dict]:
    if not plan_ids:
        return []
    backup = session.client("backup")
    result = []
    for pid in plan_ids:
        try:
            resp = backup.get_backup_plan(BackupPlanId=pid)
            result.append(resp.get("BackupPlan", {}))
        except ClientError as e:
            print(f"[WARN] Backup plan '{pid}' not accessible: {e}")
    return result


# ---------------------------------------------------------------------------
# Route 53 discovery
# ---------------------------------------------------------------------------

def get_route53_records(session, public_ips: list[str], elb_dns_names: list[str]) -> list[dict]:
    """
    Scan all Route 53 hosted zones for records pointing to this instance's
    public IPs (A records) or ELB DNS names (ALIAS / CNAME records).
    Returns list of dicts: {zone_id, zone_name, record_name, record_type, target}
    """
    r53     = session.client("route53")
    ip_set  = set(public_ips)
    # Normalise ELB DNS names for matching (strip trailing dot, lowercase)
    elb_set = {d.rstrip(".").lower() for d in elb_dns_names}
    found   = []
    try:
        zones = r53.list_hosted_zones().get("HostedZones", [])
        for zone in zones:
            zone_id   = zone["Id"].split("/")[-1]
            zone_name = zone["Name"]
            paginator = r53.get_paginator("list_resource_record_sets")
            for page in paginator.paginate(HostedZoneId=zone_id):
                for rr in page["ResourceRecordSets"]:
                    rtype = rr["ResourceRecords"] if "ResourceRecords" in rr else []
                    alias = rr.get("AliasTarget", {})

                    # A record pointing directly to instance IP
                    for val in rtype:
                        if rr["Type"] == "A" and val["Value"] in ip_set:
                            found.append({"zone_id": zone_id, "zone_name": zone_name,
                                          "record_name": rr["Name"], "record_type": "A",
                                          "target": val["Value"]})

                    # ALIAS record pointing to an ELB
                    alias_dns = alias.get("DNSName", "").rstrip(".").lower()
                    if alias_dns and any(alias_dns.endswith(e) or e.endswith(alias_dns) for e in elb_set):
                        found.append({"zone_id": zone_id, "zone_name": zone_name,
                                      "record_name": rr["Name"], "record_type": "ALIAS",
                                      "target": alias.get("DNSName", "")})

                    # CNAME pointing to an ELB
                    for val in rtype:
                        if rr["Type"] == "CNAME":
                            cname_val = val["Value"].rstrip(".").lower()
                            if any(cname_val.endswith(e) or e.endswith(cname_val) for e in elb_set):
                                found.append({"zone_id": zone_id, "zone_name": zone_name,
                                              "record_name": rr["Name"], "record_type": "CNAME",
                                              "target": val["Value"]})
    except ClientError as e:
        print(f"[WARN] Route 53 not accessible: {e}")
    return found


